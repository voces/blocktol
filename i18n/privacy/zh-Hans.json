  },
  "privacy.store.locale.detail": {
    "message": "你在游戏中选择的语言，或你浏览器的语言，以便通知以你的语言显示。你的时区在你游玩时用于选择正确的每日挑战，但不会被存储。",
    "hash": "c263f9b60422f39bc947e1eddd7290384cba345f43159617633827aa2749d7ac"
  },
  "privacy.store.locale.term": {
