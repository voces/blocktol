  "privacy.who.body": {
    "message": "当你首次打开游戏时，你的设备会生成一个随机的匿名 ID，并将其保存在浏览器的本地存储中。我们正是通过该 ID 在你多次访问时识别你的建造与统计数据。我们不知道你的姓名（除非你输入了显示名称）、你的邮箱，或你的身份——只有这个随机 ID。",
    "hash": "a70b267c182d0ec1599b50f8ba5430c138803aa42f0819ac6004fecbc1a223e9"
  },
  "privacy.who.heading": {
    "message": "你对我们而言是谁",
    "hash": "c7bc29b282cb745da958355a0ff05b3891b9a0c10e1784ace1f7485b43b08b86"
  }
}
