{
  "privacy.back": {
    "message": "返回 Blocktol",
    "hash": "2ded685ef9f4b6f9a021f7b2bd21926f2ca5d939c324db95d5b9a6406e631332"
  },
  "privacy.basis.body": {
    "message": "用于运行你正在玩的游戏（计分、历史记录、排行榜），以及保持其安全和正常运作（日志和诊断）。推送通知仅在获得你同意后发送；你可以随时关闭。",
    "hash": "ecced141f16f5095ad46c3e97d6a48e127a0908e47f0d221e962bbea7d8afdb0"
  },
  "privacy.basis.heading": {
    "message": "我们为何使用它",
    "hash": "376548c338b9f9e54845820f07499504fafaf44504b22087f621e094faa9e406"
  },
  "privacy.children.body": {
    "message": "Blocktol 并非面向 13 岁以下的儿童，我们也不会在知情的情况下收集他们的个人信息。如果某位儿童输入了个人信息，例如将真实姓名用作显示名称，请联系我们，我们会将其删除。",
    "hash": "9b8a8ed96a52dbdc8e779fa7d4ac1269629cebced4bfffbf0d89e7624e751ea7"
  },
  "privacy.children.heading": {
    "message": "儿童",
    "hash": "3583a358a585b13b6d6228f12d2baf3ef937fcf50bed4a521b70f95a520bc933"
  },
  "privacy.contact.body": {
    "message": "对隐私有疑问？请发送邮件至 {email}，或在 {discord} 中询问。",
    "hash": "80be4c53a7053c203e4d9994837edec9845d1e055869f4c4da49db9239f4d4b2"
  },
  "privacy.contact.heading": {
    "message": "联系我们",
    "hash": "2b5c3d26721ae9c350cf3009318b626f0fc8a90b4a2ac0ca8099c05aa849282e"
  },
  "privacy.contact.operator": {
    "message": "Blocktol 由位于美国的 Robert Coe 运营，他负责本页面上的数据。",
    "hash": "5f726d42b223e4f8afbe0932a8f898f341905efbfc7f26293bb2c066e5a2d89c"
  },
  "privacy.cookies.body": {
    "message": "我们不使用 Cookie，也不运行任何广告或第三方追踪。存储在你设备上的唯一内容是游戏运行所需的功能性数据（你的 ID、你进行中的建造，以及你的设置），因此没有需要点击处理的 Cookie 横幅。",
    "hash": "744a642c9b8aac084c482057705efa12d8ed7aed8e6a11d5196e45052a1aee38"
  },
  "privacy.cookies.heading": {
    "message": "Cookie",
    "hash": "141395eb35564fe50baa1839eb43315ec1880ae19f53b926611a483029a5a603"
  },
  "privacy.docTitle": {
    "message": "隐私与数据 — Blocktol",
    "hash": "e58f9eb6f220fcf1ffe433efec1d8f3407fcf12ac8759bc0f6f263afb119fcf1"
  },
  "privacy.footer": {
    "message": "Blocktol — 一款每日迷宫建造游戏。",
    "hash": "2c60840c5bc476c16d30c14a2111199bf597bf5acbfb58ea2eaf700518384da6"
  },
  "privacy.history": {
    "message": "更改历史",
    "hash": "964de7c92efed6df5691a3c05dd99b3796e103ba8696692a5b6cdeee3f5d61fd"
  },
  "privacy.intro": {
    "message": "Blocktol 是一款每日迷宫建造游戏，无需账户——无需注册、无需邮箱、无需密码。本页面确切说明我们存储什么、为什么存储，以及你如何获取其副本或将其删除。",
    "hash": "1122c2fda98d7da426c41db76896d03d1d08daf707f5cb4f22524f10fd60ae0f"
  },
  "privacy.languages": {
    "message": "语言",
    "hash": "a4fe65264ef7dbb38d104b1e81eb3350f3142f3d16f32bdec39b1d9b42c1b8d1"
  },
  "privacy.others.discord.detail": {
    "message": "每天的最佳成绩（显示名称和时间）会发布到 Blocktol 的 Discord 服务器。即使你删除了自己的数据，这些帖子仍会保留。",
    "hash": "0262507ff50fd53f99eedaffc085f4cbbf3ff7cff5cc155686b265445b0e3f32"
  },
  "privacy.others.discord.term": {
    "message": "Discord",
    "hash": "053bc65874ad6098e58c41c57b378a2f36b0220e5e0b46722245e6c2f796818c"
  },
  "privacy.others.heading": {
    "message": "还有谁能看到它",
    "hash": "e80578316188d2f3153b3e49da8a7f76c0caadd29462c608f7f85ce557c2c87a"
  },
  "privacy.others.intro": {
    "message": "我们自己的服务器与数据库运行着这款游戏。除此之外，少数服务可能代表我们处理有限的数据：",
    "hash": "4ffd96571327848d4db86d60595208430e7fa9775fd1a961773be05e54bef869"
  },
  "privacy.others.never": {
    "message": "我们绝不出售你的数据，也不将其用于广告。",
    "hash": "10b9ce670ca5de371417fbf79a6fa00c8d8fb972f10d99d36cbc74390fca8efe"
  },
  "privacy.others.push.detail": {
    "message": "如果你开启通知，你浏览器的推送服务（例如 Google、Mozilla 或 Apple）会负责投递它们。",
    "hash": "b8fbff5bb316a0d11f783d566e9bca0ef708bae60e40a2bcba065ecf90949286"
  },
  "privacy.others.push.term": {
    "message": "推送投递",
    "hash": "548cf71685801bbc44c06fbe58b694d0dbf9a80d2293c2ba8e8a536e36ead8d9"
  },
  "privacy.readEnglish": {
    "message": "阅读英文版本",
    "hash": "971012a5337e5192d5ca9b242712d22c57e69d6f8b5f8ca5d44de236c3b0336e"
  },
  "privacy.retention.body": {
    "message": "在你进行游戏期间，你的个人资料和构建会被保留，以便你的统计数据和历史记录保持完整。删除你的数据（见上文）即可更快地移除它们。应用内通知将在 90 天后删除，从未进行过游戏的个人资料将在 30 天后移除。诊断信息将在大约 30 天后删除，服务器访问日志将在 14 天后删除。仅为从故障中恢复而保留的备份将在最多 30 天后删除；如果我们曾经恢复某个备份，我们会再次删除你曾要求我们删除的任何数据。为了实现这一点，我们会保留一个已删除个人资料旧 ID 的单向哈希值，该哈希值无法被还原成原始 ID。",
    "hash": "e0d8e1793c5300783a7fe5ddcf106df149e2132e3ac986c712d043e957df905b"
  },
  "privacy.retention.heading": {
    "message": "我们保留数据多久",
    "hash": "a37efe89b9d228de92a171d552292264c57d9d45511f9ec1460f1e22e81eeea0"
  },
  "privacy.rights.delete.body": {
    "message": "永久移除你的个人资料、名称、偏好设置、通知和推送订阅，并将你构建的每一个迷宫与你解除关联。你的构建将作为匿名玩家保留在过往的排行榜上，不再通过我们保存的任何信息与你关联，因此其他人参与竞争的那些日子的历史结果不会被改写。已经发布到 Discord 的名称，以及已经发送给其他玩家的通知中的你的名称（在 90 天后删除），将继续保留在那里。此操作无法撤销，你的设备将作为一名全新玩家重新开始。",
    "hash": "5956e089c7d3dd0f8ed19638dcac4c5afae44f3ae3c70165a3701add4624ad4a"
  },
  "privacy.rights.export.body": {
    "message": "下载一个 JSON 文件，其中包含我们保存的关于你的所有信息——你的个人资料、每一次运行、你的通知，以及你的推送订阅。",
    "hash": "945e2495e85c2edbd3aab639dd82e01607329033125de9da8872097039e21ece"
  },
  "privacy.rights.heading": {
    "message": "你的权利",
    "hash": "08440e966836527e8f38135621ce658a5a9dd031396b6d1af5d72fe6dccd9f15"
  },
  "privacy.rights.intro": {
    "message": "你随时都可以在游戏中的 {place} 自行完成以下两项操作：",
    "hash": "dd7646341a1e57e67151235bbf03235ab44182aa4a656b9da0a75540d6024385"
  },
  "privacy.rights.more": {
    "message": "你还可以随时更改你的显示名称、向我们查询你的数据，或向你当地的数据保护机构投诉。",
    "hash": "84cb67fd0953f1bd5db8244b66927099934b8708e18cb1bbe0ef5fb286151b58"
  },
  "privacy.rights.open": {
    "message": "在 Blocktol 中打开",
    "hash": "62aac8e66146c1e3967f314813c435b98bb2bfe9ef53a55ef4286a7cffd5ac8d"
  },
  "privacy.store.diagnostics.detail": {
    "message": "为使游戏保持快速与可靠，我们的服务器会记录性能追踪与错误日志。这些数据可能包含你匿名 ID 的加扰（单向哈希）版本——绝不会是你的姓名或 ID 本身——以便我们在调试时跟踪单次会话。它们保存在我们自己的基础设施上，并在约 30 天后自动删除。",
    "hash": "ead316e651af0163dbfa6266922dd317a763dad5e7e78dc28ebf710e732f7b08"
  },
  "privacy.store.diagnostics.term": {
    "message": "诊断数据",
    "hash": "268f14bbfe119c1e92150583af960a086d7db9619a097f8aa72ff6779842f610"
  },
  "privacy.store.gameplay.detail": {
    "message": "你构建的迷宫、它们的用时，以及哪些尝试被计入，以便我们为每日挑战评分并展示排行榜。",
    "hash": "9628acbc7d2a202e79a271545507aedf43e7f5474bdd58d231bcdb5f79118bfc"
  },
  "privacy.store.gameplay.term": {
    "message": "你的游戏内容",
    "hash": "aa64cb4d6a8dbca29bc038f79a084da2955598c28a9bbe3e1215691e0641b9ba"
  },
  "privacy.store.heading": {
    "message": "我们存储什么",
    "hash": "ef301e760ee7818fd519ab87b5bd95493f14cb373818b0c1b607b45e89520b3b"
  },
  "privacy.store.id.detail": {
    "message": "上文所述的随机标识符。",
    "hash": "208d33d4a056e12585a7dd9b08b08e00e7b83795b7a830e7932a1b907b44f78d"
  },
  "privacy.store.id.term": {
    "message": "你的匿名 ID",
    "hash": "dd29575c8c9220b5424c3bf9b3f074594b40fecba4d286062dcca3d5a0ac913c"
  },
  "privacy.store.locale.detail": {
    "message": "你在游戏中选择的语言，或你浏览器的语言，以便通知以你的语言显示。你的时区在你游玩时用于选择正确的每日挑战，但不会被存储。",
    "hash": "c263f9b60422f39bc947e1eddd7290384cba345f43159617633827aa2749d7ac"
  },
  "privacy.store.locale.term": {
    "message": "语言",
    "hash": "a4fe65264ef7dbb38d104b1e81eb3350f3142f3d16f32bdec39b1d9b42c1b8d1"
  },
  "privacy.store.logs.detail": {
    "message": "我们的网络服务器会记录每一次请求：你的 IP 地址、浏览器类型以及所请求的页面。出于安全和故障排查目的保留 14 天，之后删除。",
    "hash": "0a80508f6854562cb6f1b176815bfa9eb4a4b5ef1dd29c3d707dea298645ca8d"
  },
  "privacy.store.logs.term": {
    "message": "服务器访问日志",
    "hash": "674089f26f5684d03c2cf0f55028e818e9f5a21b33da9cb44b94b5c510ee04e9"
  },
  "privacy.store.name.detail": {
    "message": "初始为随机生成；你可以更改它。",
    "hash": "ecef5bdd07a726a15dc7cbe15d6d3755efcd2a4aee620e3e93f349389b041ac4"
  },
  "privacy.store.name.term": {
    "message": "显示名称",
    "hash": "2b7f6a84de917e387539dbe441ca22056e793d738e6c50db30c3f569e4448df3"
  },
  "privacy.store.prefs.detail": {
    "message": "主题、语言、缩放以及通知设置。",
    "hash": "72d0056a6a27c0b0a9454dc28602e77d4ef7293fe5de96482e7ab8a05c519b26"
  },
  "privacy.store.prefs.term": {
    "message": "偏好设置",
    "hash": "66962f72a08883733c35df6f82a049b929f9579f19c4bc083ac99bead602eab3"
  },
  "privacy.store.push.detail": {
    "message": "仅当你开启通知时：投递通知所需的浏览器推送端点。",
    "hash": "a3603d9c4a05be1e4fae445e7635c6f4af6717a6fbabe92c0b2ef4a5ff28a16a"
  },
  "privacy.store.push.term": {
    "message": "推送订阅",
    "hash": "6c4d767659a6d8a16daed43a087f6ee95aedf25f7dd96e53c4a2e28f936fd6ff"
  },
  "privacy.store.rating.detail": {
    "message": "你在所游玩天数中的 ELO 式评分。",
    "hash": "a12a3f379e3be557338a06a363cb26b06aebcff07425aaff2432b1f71adbd846"
  },
  "privacy.store.rating.term": {
    "message": "评分",
    "hash": "9f29530464f730bd28f137cfc9ea941af137187b57c21e8ff5fefed520764d99"
  },
  "privacy.title": {
    "message": "隐私与我们收集的数据",
    "hash": "5d8c387153317832efb0d32ca4a89127f9fd69a668652d44dffb167a35a97a32"
  },
  "privacy.transfers.body": {
    "message": "我们的服务器位于美国，因此你的数据在那里处理。Discord 和你浏览器的推送服务也可能在你所在国家之外处理这些数据。",
    "hash": "6329a57a011f751dea5851eace623e34e4cdacc6e5e1ff77d1797ecfb990c34b"
  },
  "privacy.transfers.heading": {
    "message": "数据在何处处理",
    "hash": "1c8d851e7b22fcffb8402d578fe25986e708bb12b01786021ed18b71b3e5d3e9"
  },
  "privacy.translated": {
    "message": "本页面由英文自动翻译而来。如两者有出入，以英文版本为准。",
    "hash": "ca0be3ed18b3b72566720bf1ae6965025dad3d1acc006a0b88a3a2e99512359f"
  },
  "privacy.updated": {
    "message": "最后更新于 {date}",
    "hash": "ffc581c7a222d2e0a937fda1841bb375332108233e3f9ef51fcbc220d911c15b"
  },
  "privacy.who.body": {
    "message": "当你首次打开游戏时，你的设备会生成一个随机的匿名 ID，并将其保存在浏览器的本地存储中。我们正是通过该 ID 在你多次访问时识别你的建造与统计数据。我们不知道你的姓名（除非你输入了显示名称）、你的邮箱，或你的身份——只有这个随机 ID。",
    "hash": "a70b267c182d0ec1599b50f8ba5430c138803aa42f0819ac6004fecbc1a223e9"
  },
  "privacy.who.heading": {
    "message": "你对我们而言是谁",
    "hash": "c7bc29b282cb745da958355a0ff05b3891b9a0c10e1784ace1f7485b43b08b86"
  }
}
