{
  "name": "blocktol",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "npm run version && npm run i18n",
    "version": "node scripts/genVersion.ts",
    "i18n": "node scripts/genI18n.ts",
    "i18n:check": "node scripts/i18nCheck.ts",
    "i18n:unused": "node scripts/i18nUnused.ts",
    "i18n:translate": "node scripts/i18nTranslate.ts",
    "bundle": "esbuild client/index.ts --bundle --platform=browser --format=esm --minify --sourcemap=external --tsconfig-raw='{\"compilerOptions\":{\"useDefineForClassFields\":true,\"jsxFactory\":\"h\",\"jsxFragmentFactory\":\"Fragment\"}}' --outfile=public/js/index.js",
    "bundle:pathing": "esbuild common/pathing.ts --bundle --platform=browser --format=esm --minify --tsconfig-raw='{\"compilerOptions\":{\"useDefineForClassFields\":true}}' --outfile=public/js/pathing.js",
    "sourcemap:stash": "node scripts/stashSourcemap.ts",
    "symbolicate": "node scripts/symbolicate.ts",
    "build": "npm run gen && npm run bundle && npm run sourcemap:stash && npm run bundle:pathing",
    "start": "node server/index.ts",
    "dev": "npm run gen && (npm run bundle -- --watch & node --watch server/index.ts)",
    "preview": "esbuild --servedir=. --serve=8081",
    "migrate": "node server/db/migrate.ts",
    "typecheck": "npm run gen && tsc -p tsconfig.common.json && tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "npm run i18n && node --test --test-concurrency=1 \"{client,common,scripts,server}/**/*.test.{ts,tsx}\"",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run i18n:check && npm run i18n:unused && npm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@preact/signals": "2.9.2",
    "croner": "10.0.1",
    "hono": "4.13.13",
    "mysql2": "3.22.6",
    "preact": "10.29.3",
    "qrcode-generator": "1.5.2",
    "sqlstring": "2.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.112.1",
    "@dprint/json": "0.25.2",
    "@dprint/markdown": "0.26.0",
    "@dprint/typescript": "0.96.1",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "24.19.2",
    "@types/sqlstring": "2.3.2",
    "dprint": "0.62.0",
    "dprint-plugin-yaml": "0.6.0",
    "esbuild": "0.25.5",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
