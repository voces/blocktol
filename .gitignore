*.http
scratchpad
.env
# Generated at build time by scripts/genVersion.ts (the shared build SHA).
common/version.ts
# Generated by scripts/genI18n.ts from i18n/ (the compiled message catalogs).
common/i18n.generated.ts
server/privacy/catalog.generated.ts
# Client source maps, one dir per build SHA (scripts/stashSourcemap.ts).
sourcemaps/
# npm packages, installed by Deno (deno.jsonc `nodeModulesDir`).
node_modules/
