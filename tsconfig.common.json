{
  // common/ on its own, with no browser or Node globals: the compiler
  // enforces that common/ stays pure. common/api.ts is left out because it only
  // re-exports the server's API type (tsconfig.json covers it).
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["esnext"] },
  "include": ["common/**/*.ts"],
  "exclude": ["common/api.ts", "**/*.test.ts"]
}
