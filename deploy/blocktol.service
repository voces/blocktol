# Reference template for the systemd unit on the EC2 cohost. Nothing reads this
# file live — the authoritative copy is /etc/systemd/system/blocktol.service,
# copied from here. Keep the two in sync (see deploy/README.md). The w3xio
# /deploy webhook restarts this unit after each merge (rebuilding the client
# bundle first).
[Unit]
Description=Blocktol (Node server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/blocktol

# All runtime config lives here (chmod 600): PORT, APP_ENV=prod, SQL_PASSWORD,
# SQL_PROXY_URL, VAPID_PUBLIC_KEY/PRIVATE_KEY/SUBJECT, and the OTel telemetry
# vars (OTEL_SERVICE_NAME and the per-signal endpoints — see server/CLAUDE.md's
# Observability section). SQL_PROXY_URL points at the LOCAL /sql proxy
# (http://127.0.0.1:3626/sql) to drop the internet hop.
EnvironmentFile=/home/ubuntu/blocktol/.env

# The client bundle is rebuilt by the deploy webhook, not here, so start is fast;
# a fresh checkout must run ./deploy/build once during setup. Node 24, as
# /usr/bin/node; it runs the server's .ts directly.
ExecStart=/usr/bin/node server/index.ts

# On SIGTERM the server drains in-flight requests and any running cron (up to
# ~65s, see server/index.ts), flushes telemetry and exits 0. Give it room
# before SIGKILL. 143 is a process's exit on an unhandled SIGTERM, kept so that
# path isn't a failure.
TimeoutStopSec=90
SuccessExitStatus=143 SIGTERM

# The day logic (puzzle dates, the rating close) assumes UTC; pin it rather
# than rely on the box's zone.
Environment=TZ=UTC

# Tag journal lines "blocktol" (journalctl -u blocktol works regardless).
SyslogIdentifier=blocktol

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
