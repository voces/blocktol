# systemd unit for the Deno server on the EC2 cohost. Install to
# /etc/systemd/system/blocktol.service (see deploy/README.md), then
# `systemctl enable --now blocktol`. The w3xio /deploy webhook restarts this unit
# after each merge (it rebuilds the client bundle first).
[Unit]
Description=Blocktol (Deno server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verit
WorkingDirectory=/home/verit/blocktol

# All runtime config lives here (chmod 600): PORT, APP_ENV=prod, SQL_PASSWORD,
# SQL_PROXY_URL, NEW_RELIC_API_KEY, VAPID_PUBLIC_KEY/PRIVATE_KEY/SUBJECT.
# SQL_PROXY_URL should point at the LOCAL /sql proxy to drop the internet hop,
# e.g. SQL_PROXY_URL=http://127.0.0.1:<proxy-port>/sql
EnvironmentFile=/home/verit/blocktol/.env

# Absolute path required by systemd — set to `which deno` on the box. The client
# bundle is rebuilt by the deploy webhook, not here, so start is fast; a fresh
# checkout must `deno task build` once during setup.
ExecStart=/home/verit/.deno/bin/deno task start

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
