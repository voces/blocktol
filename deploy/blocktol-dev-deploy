#!/bin/bash
# Reference template — nothing reads this file live. The authoritative copy is
# /usr/local/bin/blocktol-dev-deploy (0755), copied from here; see "Dev
# instance" in deploy/README.md. It runs from that installed copy, never from
# the checkout, because the checkout is what it replaces.
#
# Deploys one commit to the dev instance: fetch it, check it out detached,
# rebuild the client, restart blocktol-dev (whose boot applies the commit's
# pending migrations to blocktol-dev). w3xio's /deploy webhook runs it for
# `{app:"blocktol-dev", version:<sha>}`, as the same user that runs prod's
# deploy (it needs write access to the checkout and the sudoers rule for the
# restart). Deploys are serialized by a lock, so the last one to arrive is the
# one left running.
set -euo pipefail
sha="${1:-}"
# The sha comes from a webhook body: accept only a full commit id.
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "usage: $0 <40-hex sha>" >&2; exit 2; }
DIR=/home/ubuntu/blocktol-dev
export PATH="/home/ubuntu/.deno/bin:$PATH"
exec 9>"$DIR/.git/blocktol-dev-deploy.lock"
flock 9
cd "$DIR"
# Fetch by commit id, not branch name: the branch may have moved on since this
# push, and what deploys must be the commit that was pushed.
git fetch --no-tags --quiet origin "$sha"
git checkout --quiet --force --detach "$sha"
deno task build
sudo systemctl restart blocktol-dev
echo "blocktol-dev now at $(git rev-parse --short HEAD)"
