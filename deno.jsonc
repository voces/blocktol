{
  "compilerOptions": {
    "lib": ["deno.unstable", "dom"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "unstable": ["cron"],
  "imports": {
    "preact": "npm:preact@^10.11.3",
    "preact/": "npm:/preact@^10.11.3/",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "qrcode-generator": "npm:qrcode-generator@^1.4.4",
    "zod": "npm:zod@^3.20.2",
    "sqlstring": "npm:sqlstring@^2.3.3",
    "mysql2/promise": "npm:mysql2@^3.11.0/promise",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http/file-server": "jsr:@std/http@^1/file-server",
    "@std/path/posix": "jsr:@std/path@^1/posix"
  },
  "tasks": {
    // Stamp the build's git SHA into common/version.ts (gitignored, generated) —
    // the one constant both the server and the bundled client read to detect a
    // stale client (see scripts/genVersion.ts). Runs first in build/dev so the
    // file exists before the bundle and the server import resolve.
    "version": "deno run --allow-run=git --allow-env=GIT_SHA --allow-write=common/version.ts scripts/genVersion.ts",
    "bundle": "deno bundle --unstable-bundle --platform browser client/index.ts -o public/js/index.js",
    "bundle:pathing": "deno bundle --unstable-bundle --platform browser common/pathing.ts -o public/js/pathing.js",
    "build": "deno task version && deno task bundle && deno task bundle:pathing",
    // --no-check (not =remote): skip type-checking at start entirely. CI's
    // `deno check` and `deno task test` are the type gate, so re-checking the
    // local graph on every boot is redundant work on the cold-start critical
    // path — dropping it shrinks the redeploy restart gap (nginx's single
    // upstream 502s while the port is unbound; see server/index.ts).
    // --allow-sys: the direct DB connector (mysql2) inspects host info when it
    // opens a connection. Harmless on the proxy transport (the driver never
    // loads). SQL_TRANSPORT/HOST/PORT/USER/DATABASE configure that connector.
    "start": "deno run --no-check --allow-net --allow-sys --allow-env=PORT,APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE,DISABLE_CRONS,VAPID_PUBLIC_KEY,VAPID_PRIVATE_KEY,VAPID_SUBJECT,DISCORD_ADMIN_WEBHOOK_URL --allow-read server/index.ts",
    "dev": "deno task version && deno task bundle --watch & deno run --no-check --allow-net --allow-sys --allow-env=PORT,APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE,DISABLE_CRONS,VAPID_PUBLIC_KEY,VAPID_PRIVATE_KEY,VAPID_SUBJECT,DISCORD_ADMIN_WEBHOOK_URL --allow-read --watch server/index.ts",
    "preview": "deno run --allow-net --allow-read jsr:@std/http@^1/file-server --port 8081 .",
    "migrate": "deno run --no-check=remote --allow-net --allow-sys --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE server/db/migrate.ts",
    // net/env grants are for the run-lifecycle integration tests, which hit
    // the (dev) database through the SQL proxy; they self-skip when
    // SQL_PASSWORD isn't set, and the pure tests need no permissions.
    "test": "deno test --allow-net=w3x.io --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE"
  },
  "deploy": {
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./server/index.ts"
    }
  },
  "lint": {
    // `scripts/` are operator CLIs where console output IS the interface, and
    // `client/` is browser code Deno's server-tuned rules (no-window, …) don't
    // fit — so lint (and the no-console gate) covers server + common only.
    "exclude": ["public", "scripts", "client"],
    // Force server/common logging through util/logging.ts (structured logfmt);
    // the sink itself opts out with an inline `// deno-lint-ignore no-console`.
    "rules": {
      "include": ["no-console"]
    }
  },
  "fmt": {
    // common/version.ts is generated (scripts/genVersion.ts) — exclude it so a
    // build never trips `deno fmt --check` on machine-written output.
    "exclude": ["public", "common/version.ts"]
  }
}
