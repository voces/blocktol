{
  "compilerOptions": {
    "lib": ["deno.unstable", "dom"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "unstable": ["cron"],
  "imports": {
    "preact": "npm:preact@^10.11.3",
    "preact/": "npm:/preact@^10.11.3/",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "qrcode-generator": "npm:qrcode-generator@^1.4.4",
    "zod": "npm:zod@^3.20.2",
    "sqlstring": "npm:sqlstring@^2.3.3",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http/file-server": "jsr:@std/http@^1/file-server",
    "@std/path/posix": "jsr:@std/path@^1/posix"
  },
  "tasks": {
    "bundle": "deno bundle --unstable-bundle --platform browser client/index.ts -o public/js/index.js",
    "bundle:pathing": "deno bundle --unstable-bundle --platform browser common/pathing.ts -o public/js/pathing.js",
    "build": "deno task bundle && deno task bundle:pathing",
    "start": "deno run --no-check=remote --allow-net --allow-env=PORT,APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,DISABLE_CRONS,NEW_RELIC_API_KEY,VAPID_PUBLIC_KEY,VAPID_PRIVATE_KEY,VAPID_SUBJECT --allow-read server/index.ts",
    "dev": "deno task bundle --watch & deno run --no-check=remote --allow-net --allow-env=PORT,APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,DISABLE_CRONS,NEW_RELIC_API_KEY,VAPID_PUBLIC_KEY,VAPID_PRIVATE_KEY,VAPID_SUBJECT --allow-read --watch server/index.ts",
    "preview": "deno run --allow-net --allow-read jsr:@std/http@^1/file-server --port 8081 .",
    "migrate": "deno run --no-check=remote --allow-net --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL server/db/migrate.ts",
    // net/env grants are for the run-lifecycle integration tests, which hit
    // the (dev) database through the SQL proxy; they self-skip when
    // SQL_PASSWORD isn't set, and the pure tests need no permissions.
    "test": "deno test --allow-net=w3x.io --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL"
  },
  "deploy": {
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./server/index.ts"
    }
  },
  "lint": {
    "exclude": ["public"]
  },
  "fmt": {
    "exclude": ["public"]
  }
}
