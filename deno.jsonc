{
  // npm packages install into ./node_modules (gitignored), where esbuild, which
  // can't read the import map, resolves the client bundle's imports.
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.unstable", "dom"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "imports": {
    "preact": "npm:preact@^10.11.3",
    "preact/": "npm:/preact@^10.11.3/",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "qrcode-generator": "npm:qrcode-generator@^1.4.4",
    "zod": "npm:zod@^3.20.2",
    "sqlstring": "npm:sqlstring@^2.3.3",
    "mysql2/promise": "npm:mysql2@^3.11.0/promise",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "croner": "npm:croner@10.0.1",
    // The Node HTTP server (server/index.ts); hono is its peer, imported by it.
    "@hono/node-server": "npm:@hono/node-server@2.1.4",
    "hono": "npm:hono@4.13.13",
    // Telemetry (server/otel.ts): one release set, so the 2.x SDK and the 0.x
    // experimental packages move together.
    "@opentelemetry/api-logs": "npm:@opentelemetry/api-logs@0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "npm:@opentelemetry/exporter-logs-otlp-proto@0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "npm:@opentelemetry/exporter-trace-otlp-proto@0.223.0",
    "@opentelemetry/instrumentation": "npm:@opentelemetry/instrumentation@0.223.0",
    "@opentelemetry/instrumentation-undici": "npm:@opentelemetry/instrumentation-undici@0.33.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@2.12.0",
    "@opentelemetry/sdk-logs": "npm:@opentelemetry/sdk-logs@0.223.0",
    "@opentelemetry/sdk-trace": "npm:@opentelemetry/sdk-trace@2.12.0",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@2.12.0",
    "@opentelemetry/core": "npm:@opentelemetry/core@2.12.0",
    // Types only, for `deno task typecheck` (tsc reads them from node_modules).
    "@types/sqlstring": "npm:@types/sqlstring@2.3.2",
    "@types/node": "npm:@types/node@24.19.2",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path/posix": "jsr:@std/path@^1/posix"
  },
  "tasks": {
    // Stamp the build's git SHA into common/version.ts (gitignored, generated) —
    // the one constant both the server and the bundled client read to detect a
    // stale client (see scripts/genVersion.ts). Runs first in build/dev so the
    // file exists before the bundle and the server import resolve.
    "version": "deno run --allow-run=git --allow-env=GIT_SHA --allow-write=common/version.ts scripts/genVersion.ts",
    // Compile the message catalogs (i18n/**.json) into common/i18n.generated.ts
    // and the privacy page's server/privacy/catalog.generated.ts —
    // gitignored/generated like common/version.ts, so it must run before the
    // bundle and before `deno check`/`deno test` resolve the import graph (both
    // reach it through common/notifications.ts). --no-check: genI18n imports the
    // catalog runtime type-only, so it must not try to type-check common/i18n.ts,
    // whose generated import is exactly what this task is about to create.
    "i18n": "deno run --no-check --allow-read=i18n --allow-write=common/i18n.generated.ts,server/privacy/catalog.generated.ts scripts/genI18n.ts",
    // The "never deploy untranslated" gate (CI, blocking): every configured
    // target locale must have a current, valid translation of every en.json key.
    // Pure/network-free — safe on forks. i18n:translate is the auto-fixer that
    // heals it; i18n:unused fails the build on a key no code references.
    "i18n:check": "deno run --no-check --allow-read=i18n scripts/i18nCheck.ts",
    "i18n:unused": "deno run --no-check --allow-read=i18n,common,server,client scripts/i18nUnused.ts",
    "i18n:translate": "deno run --no-check --allow-read --allow-write=i18n --allow-env --allow-net --allow-sys scripts/i18nTranslate.ts",
    // esbuild, pinned to an exact version so a rebuild reproduces a past bundle
    // byte for byte. Minified (~47% smaller; output is deterministic, so
    // assets.ts's `?v` hash is stable). --tsconfig-raw passes the compiler
    // options Deno applies and esbuild can't read from here: define-semantics
    // class fields and the JSX factory. The external source map doesn't change
    // the JS; `build` moves it out of public/ (never served) into
    // sourcemaps/<SHA>/ for `deno task symbolicate`, which turns a relayed
    // client stack back into source positions.
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-run npm:esbuild@0.25.5 client/index.ts --bundle --platform=browser --format=esm --minify --sourcemap=external --tsconfig-raw='{\"compilerOptions\":{\"useDefineForClassFields\":true,\"jsxFactory\":\"h\",\"jsxFragmentFactory\":\"Fragment\"}}' --outfile=public/js/index.js",
    "sourcemap:stash": "deno run --allow-read --allow-write scripts/stashSourcemap.ts",
    "symbolicate": "deno run --allow-read --allow-write --allow-env --allow-run=git,deno scripts/symbolicate.ts",
    "bundle:pathing": "deno run --allow-read --allow-write --allow-env --allow-run npm:esbuild@0.25.5 common/pathing.ts --bundle --platform=browser --format=esm --minify --tsconfig-raw='{\"compilerOptions\":{\"useDefineForClassFields\":true}}' --outfile=public/js/pathing.js",
    // TypeScript 7 (pinned): common/ alone, then the app. deno install fetches
    // the types-only packages nothing imports at runtime.
    "typecheck": "deno install && deno run --allow-read --allow-env --allow-run npm:typescript@7.0.2/tsc -p tsconfig.common.json && deno run --allow-read --allow-env --allow-run npm:typescript@7.0.2/tsc -p tsconfig.json",
    "build": "deno task i18n && deno task version && deno task bundle && deno task sourcemap:stash && deno task bundle:pathing",
    // The server runs on Node 24 (#226), which strips the types and runs the
    // .ts as-is: no build or check step on the restart path (nginx's single
    // upstream 502s while the port is unbound; see server/index.ts). Its npm
    // packages resolve from ./node_modules, which `deno install` fills.
    "start": "node server/index.ts",
    "dev": "deno task i18n && deno task version && deno task bundle --watch & node --watch server/index.ts",
    "preview": "deno run --allow-net --allow-read jsr:@std/http@^1/file-server --port 8081 .",
    "migrate": "deno run --no-check=remote --allow-net --allow-sys --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE server/db/migrate.ts",
    // net/env grants are for the run-lifecycle integration tests, which hit
    // the (dev) database through the SQL proxy; they self-skip when
    // SQL_PASSWORD isn't set, and the pure tests need no permissions.
    // i18n first: the pure tests import common/notifications.ts, which imports the
    // generated catalog — so a fresh checkout must compile it before testing.
    "test": "deno task i18n && deno test --allow-read --allow-net=w3x.io --allow-env=APP_ENV,SQL_PASSWORD,SQL_PROXY_URL,SQL_TRANSPORT,SQL_HOST,SQL_PORT,SQL_USER,SQL_DATABASE"
  },
  "lint": {
    // `scripts/` are operator CLIs where console output IS the interface, and
    // `client/` is browser code Deno's server-tuned rules (no-window, …) don't
    // fit — so lint (and the no-console gate) covers server + common only.
    "exclude": ["public", "scripts", "client"],
    // Force server/common logging through util/logging.ts (structured logfmt);
    // the sink itself opts out with an inline `// deno-lint-ignore no-console`.
    "rules": {
      "include": ["no-console"]
    }
  },
  "fmt": {
    // common/version.ts and the compiled catalogs are generated — exclude them
    // so a build never trips `deno fmt --check` on machine-written output.
    "exclude": [
      "public",
      "common/version.ts",
      "common/i18n.generated.ts",
      "server/privacy/catalog.generated.ts"
    ]
  }
}
