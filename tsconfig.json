{
  // Checks nothing itself: it names the three real programs so that editors
  // and oxlint's type-aware rules give each file the settings of the program
  // that owns it (a test is typed by tsconfig.tools.json, not inferred).
  "files": [],
  "references": [
    { "path": "./tsconfig.common.json" },
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.tools.json" }
  ]
}
