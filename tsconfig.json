{
  // The app: client, server and common/ in one program, because the client's
  // API type is derived from server code. The server runs on Node, so it sees
  // Node's types. Tests and scripts are tsconfig.tools.json's.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": ["node"]
  },
  "include": ["client/**/*", "common/**/*", "server/**/*"],
  "exclude": ["**/*.test.ts"]
}
